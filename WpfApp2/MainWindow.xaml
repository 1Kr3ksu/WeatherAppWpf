<ui:FluentWindow x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WpfApp2"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
           Title="Aplikacja Pogodowa" Width="800" Height="600"
           ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Aplikacja Pogodowa" />

        <Grid Grid.Row="1" Margin="20 , 20 , 20 , 20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
            <TextBlock Text="Miasto" FontWeight="Bold"/>
            <ComboBox x:Name="CityComboBox"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,5,0,10">
            </ComboBox>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                          Margin="0,0,0,10" />

            <TextBlock Text="Data" FontWeight="Bold"/>
            <TextBlock x:Name="DateTextBlock"
                       Margin="0,5,0,10"
                       Text="{Binding ApiDate}" />

            <TextBlock Text="Godzina" FontWeight="Bold"/>
            <TextBlock x:Name="TimeTextBlock"
                       Margin="0,5,0,20"
                       Text="{Binding ApiTime}" />

            <Button x:Name="RefreshButton" Click="RefreshButton_Click" IsDefault="True" Content="Odśwież" Margin="0,5,0,5" />
            <Button x:Name="SettingsButton" Content="Ustawienia" Margin="0,5,0,5" />
        </StackPanel>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Aktualna pogoda -->
                    <RowDefinition Height="Auto" />

                    <!-- Wilgotność, wiatr, ciśnienie -->
                    <RowDefinition Height="Auto" />

                    <!-- Prognoza na 7 dni -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- AKTUALNA POGODA -->
                <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                VerticalAlignment="Top"
                Margin="0,0,0,12">

                    <Image x:Name="WeatherIcon"
               Width="80"
               Height="80"
               Margin="0,0,12,0" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                Text="{Binding Weather.Current.Temp_C,
                       StringFormat={}{0:0.#} °C,
                       TargetNullValue=-- °C}"
                FontSize="36"
                FontWeight="Bold" />

                        <TextBlock
                Text="{Binding Weather.Current.Condition.Text,
                       TargetNullValue=--}"
                FontSize="16"
                TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- PARAMETRY AKTUALNEJ POGODY -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Wilgotność"
                       FontWeight="Bold" />

                        <TextBlock
                Text="{Binding Weather.Current.Humidity,
                       StringFormat={}{0} %,
                       TargetNullValue=-- %}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Wiatr"
                       FontWeight="Bold" />

                        <TextBlock
                Text="{Binding Weather.Current.Wind_Kph,
                       StringFormat={}{0:0.#} km/h,
                       TargetNullValue=-- km/h}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ciśnienie"
                       FontWeight="Bold" />

                        <TextBlock
                Text="{Binding Weather.Current.Pressure_Mb,
                       StringFormat={}{0:0.#} hPa,
                       TargetNullValue=-- hPa}" />
                    </StackPanel>
                </Grid>

                <!-- PROGNOZA NA 7 DNI -->
                <ListBox x:Name="ForecastListBox"
             Grid.Row="2"
             ItemsSource="{Binding Forecast}"
             BorderThickness="0"
             Padding="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                        Margin="0,3"
                        CornerRadius="8"
                        BorderBrush="#33000000"
                        BorderThickness="0,0,0,1">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayName}"
                                       FontWeight="SemiBold" />

                                        <TextBlock Text="{Binding DateText}"
                                       Opacity="0.7" />

                                        <TextBlock Text="{Binding Condition}"
                                       TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Image Grid.Column="1"
                               Width="36"
                               Height="36"
                               VerticalAlignment="Center"
                               Source="{Binding Icon}" />

                                    <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">

                                        <TextBlock
                                Text="{Binding TemperatureText}"
                                FontWeight="SemiBold" />

                                        <TextBlock
                                Text="{Binding ChanceOfRain,
                                       StringFormat={}{0}% opadów}"
                                FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

        </Grid>
    </Grid>
</ui:FluentWindow>

